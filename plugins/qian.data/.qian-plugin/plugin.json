{
  "$schema": "https://qian.dev/schemas/plugin/v2",
  "id": "qian.data",
  "version": "1.0.0",
  "description": "组件配置骨架，真实 Provider 由后续组件任务实现：qian.data",
  "author": {
    "name": "Qian"
  },
  "license": "Apache-2.0",
  "interface": {
    "displayName": "data",
    "category": "platform"
  },
  "inject": [],
  "provides": [
    "Data"
  ],
  "policy": {
    "tier": "system",
    "sandbox": "none",
    "authentication": "ON_INSTALL",
    "required": false,
    "permissions": {
      "secrets": [
        {
          "name": "data/*",
          "scope": "tenant"
        }
      ]
    }
  },
  "scopes": [
    "global",
    "tenant"
  ],
  "x-skeleton": true,
  "runtime": {
    "form": "module",
    "entry": "Qian.Data.DataPlugin, Qian.Data"
  },
  "x-qian-generated": {
    "$generated": true,
    "fields": [
      "/inject",
      "/provides",
      "/runtime/form",
      "/runtime/entry"
    ],
    "tools": []
  }
}
