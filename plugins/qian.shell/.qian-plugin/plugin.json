{
  "$schema": "https://qian.dev/schemas/plugin/v2",
  "id": "qian.shell",
  "version": "1.0.0",
  "description": "基于 TypeScript 插件树的 MF2 前端外壳，提供版本化插槽、受控桥接与官方远程按需加载。",
  "author": {
    "name": "Qian"
  },
  "license": "Apache-2.0",
  "interface": {
    "displayName": "shell",
    "category": "platform"
  },
  "inject": [],
  "provides": [
    "Shell"
  ],
  "policy": {
    "tier": "system",
    "sandbox": "none",
    "authentication": "ON_INSTALL",
    "required": false
  },
  "scopes": [
    "global",
    "tenant"
  ],
  "x-skeleton": true,
  "runtime": {
    "form": "ui",
    "entry": "./ui/dist/index.html",
    "configSchema": "./schemas/config.schema.json"
  }
}
