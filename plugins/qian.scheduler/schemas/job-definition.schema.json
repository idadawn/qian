{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qian.dev/schemas/scheduler-job-definition/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "businessKey",
    "target",
    "parameters",
    "schedule"
  ],
  "properties": {
    "businessKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*/[a-z][a-z0-9._-]*$",
      "description": "必须同时存在于当前可见 local 作业目录及真实能力绑定；不接受 URL。"
    },
    "parameters": {
      "type": "object"
    },
    "schedule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runAt"
          ],
          "properties": {
            "runAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cron"
          ],
          "properties": {
            "cron": {
              "type": "string",
              "minLength": 11,
              "maxLength": 256,
              "description": "UTC 6/7 段 Quartz cron。"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "firstRunAt",
            "intervalSeconds"
          ],
          "properties": {
            "firstRunAt": {
              "type": "string",
              "format": "date-time"
            },
            "intervalSeconds": {
              "type": "number",
              "minimum": 1,
              "maximum": 31536000
            }
          }
        }
      ]
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {
          "type": "string",
          "default": "00:01:00",
          "pattern": "^(?:[0-9]+\\.)?[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,7})?$",
          "description": "TimeSpan 格式；运行时语义校验范围为100毫秒至1天。"
        },
        "misfire": {
          "type": "integer",
          "enum": [
            0,
            1,
            2
          ],
          "default": 1,
          "description": "0=Skip，1=FireOnce，2=CatchUp。"
        },
        "misfireGrace": {
          "type": "string",
          "default": "00:00:05",
          "pattern": "^(?:[0-9]+\\.)?[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,7})?$",
          "description": "TimeSpan 格式；运行时语义校验范围为0至1天。"
        },
        "concurrency": {
          "type": "integer",
          "enum": [
            0,
            1
          ],
          "default": 0,
          "description": "0=Queue，1=Skip，均不并行执行同一定义。"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 3
        },
        "retryDelay": {
          "type": "string",
          "default": "00:00:05",
          "pattern": "^(?:[0-9]+\\.)?[0-9]{2}:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,7})?$",
          "description": "TimeSpan 格式；运行时语义校验范围为0至1天。"
        }
      }
    }
  }
}
