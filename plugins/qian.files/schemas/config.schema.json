{
  "type": "object",
  "properties": {
    "storage": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local",
            "oss",
            "s3"
          ],
          "description": "按名称选用 Files.Backends 中登记的存储后端。S1 只登记 local；oss / s3 由 S1-FILE-002 接入，选用未登记的后端在挂载时报 INPUT_INVALID。"
        },
        "root": {
          "type": "string",
          "description": "local 必填：对象根目录（绝对路径）。"
        },
        "bucket": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "description": "local 必填：宿主映射直传 / 直下端点的公开基址（绝对 http(s) 地址，路径与 MapQianFiles 的 TransferPath 一致）；oss / s3：对象存储服务端点。"
        },
        "accessKey": {
          "type": "string",
          "x-qian-sensitive": true
        },
        "secretKey": {
          "type": "string",
          "x-qian-sensitive": true
        }
      },
      "additionalProperties": false
    },
    "quota": {
      "type": "object",
      "properties": {
        "perTenantBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "租户字节配额的平台默认值；租户覆盖经租户配置（ITenantSettings）写入，优先于此值。"
        }
      },
      "additionalProperties": false,
      "default": {
        "perTenantBytes": 10737418240
      }
    },
    "policies": {
      "type": "array",
      "description": "平台默认上传策略；组件也可在 Apply 中经 IFileService.Policies 登记自己的用途。用途形如 <组件 ID>/<名称>，组件 ID 进入存储键。",
      "items": {
        "type": "object",
        "required": [
          "purpose",
          "allowedTypes",
          "maxSize"
        ],
        "properties": {
          "purpose": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+/[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
          },
          "allowedTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string"
            }
          },
          "maxSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1099511627776
          },
          "maxCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "required": [
    "storage"
  ]
}
