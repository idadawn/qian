{
  "$schema": "https://qian.dev/schemas/plugin/v2",
  "id": "qian.identity.client",
  "version": "1.0.0",
  "description": "身份依赖方组件：服务端授权码 + PKCE 换取、qian.sid Cookie 会话与刷新，下游 S2S 令牌按受众校验；可对接任意 OIDC 发行方",
  "author": {
    "name": "Qian"
  },
  "license": "Apache-2.0",
  "interface": {
    "displayName": "identity.client",
    "category": "platform"
  },
  "inject": [],
  "provides": [
    "Identity"
  ],
  "policy": {
    "tier": "system",
    "sandbox": "none",
    "authentication": "ON_INSTALL",
    "required": false,
    "permissions": {
      "secrets": [
        {
          "name": "identity/*",
          "scope": "platform"
        },
        {
          "name": "identity/*",
          "scope": "dev"
        }
      ]
    }
  },
  "scopes": [
    "global"
  ],
  "engines": {
    "kun": ">=2026.10.14"
  },
  "x-skeleton": true,
  "x-aot": true,
  "runtime": {
    "form": "module",
    "entry": "Qian.Identity.Client.IdentityClientPlugin, Qian.Identity.Client"
  },
  "x-qian-generated": {
    "$generated": true,
    "fields": [
      "/inject",
      "/provides",
      "/runtime/form",
      "/runtime/entry"
    ],
    "tools": []
  }
}
