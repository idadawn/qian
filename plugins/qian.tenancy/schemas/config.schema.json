{
  "type": "object",
  "properties": {
    "resolver": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "allowHeaderFallback": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "initializationCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*/[a-z][A-Za-z0-9_.-]*$"
      },
      "uniqueItems": true,
      "default": [],
      "description": "仅全局开户编排可以执行的初始化能力精确标识；不接受通配符。"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
