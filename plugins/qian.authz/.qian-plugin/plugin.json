  "interface": {
    "displayName": "authz",
    "category": "platform"
  },
  "inject": [
    "Data"
  ],
  "provides": [
    "Authz",
    "AuthzEnforcement",
    "AuthzPermissions",
    "AuthzResourceTypes",
    "AuthzSuperadminBypass",
    "AuthzTenantRoleGrant",
    "CommandAuthorization"
  ],
  "policy": {
    "tier": "system",
    "sandbox": "none",
    "authentication": "ON_INSTALL",
    "required": false
  },
  "scopes": [
    "global"
  ],
  "x-skeleton": true,
