  "$schema": "https://qian.dev/schemas/plugin/v2",
  "id": "qian.authz",
  "version": "1.0.0",
  "description": "提供 qian.authz 的实际代码入口与配置契约；安装状态按组件验收门管理。",
  "author": {
    "name": "Qian"
  },
