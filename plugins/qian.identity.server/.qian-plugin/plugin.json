  "$schema": "https://qian.dev/schemas/plugin/v2",
  "id": "qian.identity.server",
  "version": "1.0.0",
  "description": "提供 qian.identity.server 的实际代码入口与配置契约；安装状态按组件验收门管理。",
  "author": {
    "name": "Qian"
  },
  "license": "Apache-2.0",
  "interface": {
    "displayName": "identity.server",
    "category": "platform"
  },
  "inject": [
    "Data",
    "Tenancy"
  ],
  "provides": [
    "Identity",
    "IdentityAccounts",
    "IdentityFactors",
    "IdentitySignIn",
    "TenancyMembershipProvisioner",
    "TenancyUserCounter"
  ],
  "policy": {
    "tier": "system",
    "sandbox": "none",
    "authentication": "ON_INSTALL",
    "required": false
  },
  "scopes": [
    "global"
  ],
  "x-skeleton": true,
  "runtime": {
    "form": "module",
    "entry": "Qian.Identity.Server.IdentityServerComponent, Qian.Identity.Server",
