      "schemas/config.schema.json": {
        "$generated": true,
        "component": "qian.tenancy.signup",
        "source": "Qian.Tenancy.Signup.TenancySignupComponent, Qian.Tenancy.Signup",
        "sha256": "c632dd449ff18c9d327f51d0b5eddcd00dd6b3d53f1e237907070a58dfc8e5ac",
        "fields": [
          ""
        ]
      }
    }
  }
}
