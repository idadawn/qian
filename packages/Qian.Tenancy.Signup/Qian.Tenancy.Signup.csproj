  <ItemGroup>
    <InternalsVisibleTo Include="Qian.Tenancy.Signup.Tests" />
    <None Include="../../plugins/qian.tenancy.signup/**/*" Pack="true" PackagePath="qian/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
