  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Qian.Tenancy.Signup.Abstractions/Qian.Tenancy.Signup.Abstractions.csproj" />
