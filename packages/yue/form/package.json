{
  "name": "@idadawn/yue-form",
  "version": "0.1.0",
  "description": "Field、SchemaForm、FormApi、联动、校验与脱敏规则目录、弹层 API 与消息出口。",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idadawn/qian.git",
    "directory": "packages/yue/form"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint --strict --pack pnpm"
  },
  "dependencies": {
    "@idadawn/yue-contracts": "workspace:^",
    "@idadawn/yue-core": "workspace:^",
    "@idadawn/yue-sdk": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
