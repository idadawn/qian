{
  "name": "@yue/sdk",
  "version": "0.1.0",
  "description": "注册表 API、PlatformClient、请求拦截器链、i18n、mock 与运行时配置注入。",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idadawn/qian.git",
    "directory": "packages/yue/sdk"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint --strict --pack pnpm"
  },
  "dependencies": {
    "@yue/contracts": "workspace:^",
    "@yue/tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
