{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.qian.dev/sse/v1",
  "title": "SseEvent",
  "description": "S1 SSE 事件草案。只描述事件数据，不携带认证令牌；clientAction 的 name 与 parameters 对应客户端动作注册表。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "type",
        "payload"
      ],
      "properties": {
        "version": {
          "const": "v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "text"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "type",
        "payload"
      ],
      "properties": {
        "version": {
          "const": "v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "recommend"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "value"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "type",
        "payload"
      ],
      "properties": {
        "version": {
          "const": "v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "toolCall"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "callId",
            "name",
            "arguments"
          ],
          "properties": {
            "callId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "arguments": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "type",
        "payload"
      ],
      "properties": {
        "version": {
          "const": "v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "toolResult"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "callId",
            "result"
          ],
          "properties": {
            "callId": {
              "type": "string"
            },
            "result": {}
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "type",
        "payload"
      ],
      "properties": {
        "version": {
          "const": "v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "artifact"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "uri"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "uri": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "type",
        "payload"
      ],
      "properties": {
        "version": {
          "const": "v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "clientAction"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "parameters"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "parameters": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "type",
        "payload"
      ],
      "properties": {
        "version": {
          "const": "v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "progress"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "messageKey"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "messageKey": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "type",
        "payload"
      ],
      "properties": {
        "version": {
          "const": "v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "end"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "type",
        "payload"
      ],
      "properties": {
        "version": {
          "const": "v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "error"
        },
        "payload": {
          "$ref": "./error-detail.schema.json"
        }
      }
    }
  ]
}
