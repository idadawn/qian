{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.qian.dev/data-column/v1",
  "title": "DataColumnMeta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "field",
    "titleKey"
  ],
  "properties": {
    "field": {
      "type": "string",
      "minLength": 1
    },
    "titleKey": {
      "type": "string",
      "minLength": 1
    },
    "sortable": {
      "type": "boolean"
    },
    "filterable": {
      "type": "boolean"
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fixed": {
      "enum": [
        "left",
        "right"
      ]
    }
  }
}
