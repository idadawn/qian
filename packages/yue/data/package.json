{
  "name": "@idadawn/yue-data",
  "version": "0.1.0",
  "description": "DataTable 基础版、Tree 族、日期族、Upload 与 ImportWizard。",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idadawn/qian.git",
    "directory": "packages/yue/data"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publint": "publint --strict --pack pnpm",
    "test": "vitest run",
    "contracts:generate": "pnpm --workspace-root openapi:generate --source packages/yue/data/contracts/upload.openapi.json --output packages/yue/data/src/upload.generated.ts",
    "contracts:check": "pnpm --workspace-root openapi:generate --source packages/yue/data/contracts/upload.openapi.json --output packages/yue/data/src/upload.generated.ts --check"
  },
  "dependencies": {
    "@idadawn/yue-core": "workspace:^",
    "@idadawn/yue-sdk": "workspace:^",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@idadawn/yue-contracts": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "tailwindcss": "catalog:",
    "@idadawn/yue-tokens": "workspace:^",
    "ajv": "catalog:"
  }
}
