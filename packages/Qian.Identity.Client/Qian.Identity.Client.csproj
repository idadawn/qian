<Project Sdk="Microsoft.NET.Sdk">
  <!-- gateway profile 是 AOT 树（build.aot: true）；组件清单的 x-aot 由 tools/Qian.Identity.Client.AotSmoke 的 NativeAOT 冒烟背书（S1-IDP-014）。 -->
  <PropertyGroup><IsPackable>true</IsPackable><IsAotCompatible>true</IsAotCompatible><Description>依赖方（RP）接入：服务端授权码 + PKCE 换取、qian.sid Cookie 会话、刷新与 discovery 定期刷新，以及下游 S2S 令牌校验；可对接任意 OIDC 发行方。</Description></PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Qian.Runtime.Errors.AspNetCore/Qian.Runtime.Errors.AspNetCore.csproj" />
    <ProjectReference Include="../Qian.Identity.Abstractions/Qian.Identity.Abstractions.csproj" />
    <ProjectReference Include="../Qian.Config.Abstractions/Qian.Config.Abstractions.csproj" />
    <PackageReference Include="Kun.Identity" />
    <PackageReference Include="Kun.Identity.AspNetCore" />
    <PackageReference Include="Kun.Security" />
    <InternalsVisibleTo Include="Qian.Identity.Client.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Qian.Plugin.Sdk/Qian.Plugin.Sdk.csproj" />
    <ProjectReference Include="../Qian.Plugin.Sdk.Generators/Qian.Plugin.Sdk.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
