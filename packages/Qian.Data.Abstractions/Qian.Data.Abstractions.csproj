<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Qian 数据组件的安全上下文基类与装配错误契约。</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Qian.Runtime/Qian.Runtime.csproj" />
    <ProjectReference Include="../Qian.Config.Abstractions/Qian.Config.Abstractions.csproj" />
    <ProjectReference Include="../Qian.Events.Abstractions/Qian.Events.Abstractions.csproj" />
    <PackageReference Include="Kun.EntityFrameworkCore" />
    <PackageReference Include="Kun.MultiTenancy.EntityFrameworkCore" />
    <EmbeddedResource Include="../../contracts/v0/event-envelope.schema.json;../../contracts/v0/s2s-claims.schema.json" LogicalName="data/v0/%(Filename)%(Extension)" />
    <None Include="../../contracts/v0/event-envelope.schema.json;../../contracts/v0/s2s-claims.schema.json" Pack="true" PackagePath="contracts/v0/" />
    <EmbeddedResource Include="../../contracts/data/v1/*.json" LogicalName="data/%(Filename)%(Extension)" />
    <None Include="../../contracts/data/v1/*.json" Pack="true" PackagePath="contracts/data/v1/" />
  </ItemGroup>
</Project>
