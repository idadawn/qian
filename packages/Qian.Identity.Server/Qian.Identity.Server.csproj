<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>true</IsPackable><Description>可嵌入的 OpenIddict 身份协议服务，含 Person / Membership 账号模型与统一登录流水线。</Description></PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Qian.Runtime.Errors.AspNetCore/Qian.Runtime.Errors.AspNetCore.csproj" />
    <ProjectReference Include="../Qian.Identity.Abstractions/Qian.Identity.Abstractions.csproj" />
    <ProjectReference Include="../Qian.Data.Abstractions/Qian.Data.Abstractions.csproj" />
    <ProjectReference Include="../Qian.Events.Abstractions/Qian.Events.Abstractions.csproj" />
    <ProjectReference Include="../Qian.Tenancy.Abstractions/Qian.Tenancy.Abstractions.csproj" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Kun.Mediator" />
    <!-- 会话中心的 Redis 索引（可选：宿主登记 IConnectionMultiplexer 才启用）。 -->
    <PackageReference Include="StackExchange.Redis" />
    <!-- Argon2id：纯托管实现，随 qian.lifecycle 已钉版；不引入本机库依赖。 -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <InternalsVisibleTo Include="Qian.Identity.Server.Tests" />
  </ItemGroup>
</Project>
