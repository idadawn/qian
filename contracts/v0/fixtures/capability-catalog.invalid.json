        {
          "id": "qian.files/upload",
          "plugin": "qian.files",
          "name": "upload",
          "kind": "command",
          "description": "把一个文件上传到当前租户的文件库并返回文件 id；用于附件、头像、导出件。不用于批量迁移历史文件。",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "content",
              "fileName",
              "purpose",
              "idempotencyKey"
            ],
            "properties": {
              "content": {
                "type": "string",
                "contentEncoding": "base64"
              },
              "fileName": {
                "type": "string",
                "maxLength": 255
              },
              "purpose": {
                "enum": [
                  "attachment",
                  "avatar",
                  "export"
                ]
              },
              "idempotencyKey": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "required": [
              "fileId"
            ],
            "properties": {
              "fileId": {
                "type": "string"
              },
              "sizeBytes": {
                "type": "integer"
              }
            }
          },
          "operationId": "uploadFile",
          "sideEffect": "write",
          "policyHint": "confirm",
          "idempotent": true,
          "async": "none",
          "requiredScopes": [
            "qian.files:write"
          ],
          "requiredPermission": "qian.files:file:write",
          "requiredSecrets": [],
          "dataClassification": "internal",
          "costTier": "low",
          "contractVersion": "files-v1",
          "audit": true,
          "agent": {
            "expose": true,
            "requiresConfirmation": true
          }
        }
      ],
      "ttlMs": 1000,
      "cacheScope": "private"
    }
  }
