{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qian.dev/contracts/identity/v1/directory.member.created.v1.schema.json",
  "description": "租户成员已建立。不含姓名、账号与联系方式。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "directory_revision",
    "membership_id",
    "person_id",
    "status",
    "identity_revision"
  ],
  "properties": {
    "directory_revision": {
      "type": "integer",
      "minimum": 1
    },
    "membership_id": {
      "$ref": "https://qian.dev/contracts/v0/s2s-claims.schema.json#/$defs/Uuid"
    },
    "person_id": {
      "$ref": "https://qian.dev/contracts/v0/s2s-claims.schema.json#/$defs/Uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "locked"
      ]
    },
    "identity_revision": {
      "type": "integer",
      "minimum": 0
    }
  }
}
