{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qian.dev/schemas/scheduler-jobs/v2",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "code",
      "type",
      "target",
      "inputSchema",
      "outputSchema"
    ],
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "maxLength": 100
      },
      "type": {
        "const": "local"
      },
      "target": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*/[a-z][a-z0-9._-]*$"
      },
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {
        "type": "object"
      }
    }
  }
}
