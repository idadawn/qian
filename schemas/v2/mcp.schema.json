{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qian.dev/schemas/mcp/v2",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "$schema": {
      "const": "https://qian.dev/schemas/mcp/v2"
    },
    "mcpServers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^x-": {}
        },
        "properties": {
          "type": {
            "enum": [
              "http",
              "stdio"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "scopes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "global",
                "tenant",
                "app",
                "agent-session"
              ]
            }
          },
          "profiles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "type"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "http"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "url"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "stdio"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "command"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "mcpServers"
  ]
}
