{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qian.dev/schemas/files/upload-policies/v1",
  "type": "array",
  "maxItems": 256,
  "items": {
    "type": "object",
    "required": ["purpose", "allowedTypes", "maxSize"],
    "additionalProperties": false,
    "properties": {
      "purpose": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+/[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"},
      "allowedTypes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string"}},
      "maxSize": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
      "maxCount": {"type": "integer", "minimum": 1, "maximum": 2147483647}
    }
  }
}
