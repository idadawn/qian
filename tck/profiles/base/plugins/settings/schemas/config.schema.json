{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "port"
  ],
  "additionalProperties": false,
  "properties": {
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "marker": {
      "type": "string",
      "default": "default"
    },
    "obsolete": {
      "type": "string"
    },
    "nested": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": "fresh"
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "secret": {
      "type": "string",
      "x-qian-sensitive": true
    }
  }
}
