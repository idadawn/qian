{
  "name": "qian-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "yue:lint": "pnpm --filter @idadawn/yue-tokens tokens:check && eslint packages/yue apps",
    "yue:typecheck": "turbo run typecheck --filter=./packages/yue/* --filter=./apps/* && tsc -p tests/gates/yue/tsconfig.json",
    "yue:test": "vitest run",
    "yue:a11y": "pnpm --filter yue-playground e2e",
    "yue:lighthouse": "pnpm --filter yue-playground lighthouse",
    "yue:boundaries": "pnpm --filter @idadawn/yue-tokens build && eslint --config eslint.boundaries.config.mjs packages/yue apps",
    "yue:publint": "turbo run publint --filter=./packages/yue/*",
    "yue:circular": "depcruise --config .dependency-cruiser.cjs packages/yue apps",
    "yue:build": "turbo run build --filter=./packages/yue/* --filter=./apps/*",
    "yue:gates": "pnpm yue:lint && pnpm yue:typecheck && pnpm yue:test && pnpm yue:boundaries && pnpm yue:circular && pnpm yue:build && pnpm yue:publint && pnpm yue:a11y && pnpm yue:lighthouse",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "qian": "workspace:*",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.1",
    "vitest": "catalog:"
  }
}
