<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>集成测试共用的 Testcontainers fixture：PostgreSQL 16（含 NOBYPASSRLS 应用角色）、Redis 7、RabbitMQ、Apollo 协议替身、K3s 单节点集群、外部 OIDC 发行方 Dex。</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Qian.Testing.Containers.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ApolloMock/apollo_mock.py" LogicalName="Qian.Testing.Containers.ApolloMock.apollo_mock.py" />
    <EmbeddedResource Include="ApolloReal/apolloconfigdb.sql" LogicalName="Qian.Testing.Containers.ApolloReal.apolloconfigdb.sql" />
    <EmbeddedResource Include="ApolloReal/apolloportaldb.sql" LogicalName="Qian.Testing.Containers.ApolloReal.apolloportaldb.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dex 的本地密码库只收 bcrypt 哈希。 -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Testcontainers.K3s" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

</Project>
