<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- 启用严格发布目标不代表验收完成；默认 profile 的 AOT 标记须等完整原生运行通过后恢复。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><Description>gateway profile 的真实业务宿主。</Description>
    <PublishAot>true</PublishAot><IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn><InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../packages/Qian.Gateway/Qian.Gateway.csproj" />
    <ProjectReference Include="../../packages/Qian.Identity.Client/Qian.Identity.Client.csproj" />
    <ProjectReference Include="../../packages/Qian.Config.Apollo/Qian.Config.Apollo.csproj" />
    <ProjectReference Include="../../packages/Qian.Config.Secrets/Qian.Config.Secrets.csproj" />
    <ProjectReference Include="../../packages/Qian.Data.Native.Postgres/Qian.Data.Native.Postgres.csproj" />
    <ProjectReference Include="../../packages/Qian.Audit.Native/Qian.Audit.Native.csproj" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
</Project>
