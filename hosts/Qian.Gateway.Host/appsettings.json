{
  "Apollo": {"AppId":"qian-gateway","Env":"UAT","ConfigServer":["http://apollo-config.apollo:8080"],"Namespaces":["application","qian.common.trust"]},
  "Gateway": {
    "IdentityIssuer":"https://id.example.internal/","IdentityAudience":"https://gateway.example.internal",
    "Issuer":"https://gateway.example.internal/s2s",
    "SigningKeyPath":"/var/run/secrets/qian/gateway/private.pem","PublicKeyPath":"/var/run/secrets/qian/gateway/public.pem",
    "TrustedProxyNetworks":[],
    "Routes":[{"Id":"platform","Path":"/api/{**rest}","Cluster":"qian-platform"}],
    "Clusters":[{"Id":"qian-platform","Address":"http://qian-platform:8080/"}]
  },
  "Identity": {"ClientId":"qian-gateway","RedirectUri":"https://gateway.example.internal/auth/callback","SecretMountRoot":"/var/run/secrets","DataProtectionKeysDirectory":"/var/lib/qian/gateway/data-protection"},
  "ConnectionFiles": {"Audit":"/var/run/secrets/qian/gateway/audit-connection","PlatformAudit":"/var/run/secrets/qian/gateway/platform-audit-connection","Redis":"/var/run/secrets/qian/gateway/redis-connection"},
  "Audit": {"TenantRole":"qian_gateway_audit_tenant","PlatformRole":"qian_gateway_audit_platform","FunctionOwner":"qian_gateway_audit_writer"}
}
