{
  "Root": "/app/qian",
  "S2S": { "Issuer": "https://gateway.example.internal/s2s", "JwksUri": "http://qian-gateway:8080/.well-known/jwks.json", "AllowHttpJwks": true },
  "ConnectionFiles": {
    "App": "/var/run/secrets/qian/platform/app-connection",
    "PlatformAuthz": "/var/run/secrets/qian/platform/authz-platform-connection",
    "PlatformAudit": "/var/run/secrets/qian/platform/audit-platform-connection",
    "Migrations": "/var/run/secrets/qian/platform/migrations-connection"
  },
  "Secrets": { "MountRoot": "/var/run/secrets" },
  "Trust": { "PlatformKeys": [ { "PublicKey": "secretRef://platform/trust/platform", "NotBefore": "2026-01-01T00:00:00Z" } ] },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "None" } }
}
