    <ProjectReference Include="../../packages/Qian.Authz/Qian.Authz.csproj" />
    <ProjectReference Include="../../packages/Qian.Authz.AspNetCore/Qian.Authz.AspNetCore.csproj" />
    <ProjectReference Include="../../packages/Qian.Audit/Qian.Audit.csproj" />
    <ProjectReference Include="../../packages/Qian.Config.Apollo/Qian.Config.Apollo.csproj" />
    <ProjectReference Include="../../packages/Qian.Config.Secrets/Qian.Config.Secrets.csproj" />
    <ProjectReference Include="../../packages/Qian.Registry/Qian.Registry.csproj" />
    <ProjectReference Include="../../packages/Qian.Capabilities/Qian.Capabilities.csproj" />
    <ProjectReference Include="../../packages/Qian.Capabilities.AspNetCore/Qian.Capabilities.AspNetCore.csproj" />
    <ProjectReference Include="../../packages/Qian.Lifecycle/Qian.Lifecycle.csproj" />
