    <ProjectReference Include="../../packages/Qian.Surfaces/Qian.Surfaces.csproj" />
    <ProjectReference Include="../../packages/Qian.Plugin.Sdk.AspNetCore/Qian.Plugin.Sdk.AspNetCore.csproj" />
    <ProjectReference Include="../../packages/Qian.Runtime.Errors.AspNetCore/Qian.Runtime.Errors.AspNetCore.csproj" />
    <ProjectReference Include="../../packages/Qian.Identity.Abstractions/Qian.Identity.Abstractions.csproj" />
    <PackageReference Include="Kun.Security" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
  <ItemGroup>
    <None Include="platform.overlay.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
