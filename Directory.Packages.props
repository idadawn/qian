<Project>

  <!-- 中央包版本：csproj 里的 PackageReference 不写 Version，版本只在这里改。 -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Kun 版本单点（ADR-021 D21.3）：全部 Kun.* 的 PackageVersion 使用 [$(KunVersion)] 精确范围，缺包即失败，
    升级 Kun 只改这一处；文档站的「Kun 框架」小节与 Kun API 参考按它镜像 kun 仓库 tag v$(KunVersion)（docs-site.md §2b）。
  -->
  <PropertyGroup Label="Kun">
    <KunVersion>2026.10.14</KunVersion>
  </PropertyGroup>

  <ItemGroup Label="Gates">
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="Runtime">
    <PackageVersion Include="Kun.Configuration" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.Configuration.Apollo" Version="[$(KunVersion)]" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.KeyPerFile" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.12" />
    <PackageVersion Include="Kun.Authorization" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.AspNetCore" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.Core" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.Mediator" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.EventBus.Abstractions" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.EventBus" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.Validation" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.Identity" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.Security" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.Gateway" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.Infrastructure" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.Storage" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.Storage.Abstractions" Version="[$(KunVersion)]" />
    <!-- 授权快照缓存（qian.authz，PRD 7.5「Redis，TTL 10 分钟」）：内存与 Redis 两种后端。 -->
    <PackageVersion Include="Kun.Caching" Version="[$(KunVersion)]" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <!-- Ed25519 分离签名验签（qian.lifecycle）：.NET 10 没有独立的 Ed25519 API。 -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
    <PackageVersion Include="Grpc.AspNetCore.Server" Version="2.67.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageVersion Include="Grpc.Reflection" Version="2.67.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Kun.MultiTenancy" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.EntityFrameworkCore" Version="[$(KunVersion)]" />
    <PackageVersion Include="Kun.MultiTenancy.EntityFrameworkCore" Version="[$(KunVersion)]" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!-- 只给 dotnet ef 设计时入口用（tests/Qian.Capabilities.Tests，PrivateAssets=all），与运行时 EF Core 同版本。 -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <!-- EF Design 经 Microsoft.Build.Tasks.Core 传递引入 9.0.0（NU1902 / NU1903），钉到已修复的版本（GHSA-2fmv-rv2c-59x7、GHSA-846f-f764-76mx 均在 10.0.13 修复）。
         传递钉版（CentralPackageTransitivePinningEnabled）对全解决方案生效，目前只有 Qian.Capabilities.Tests 的依赖图含它。 -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Identity 的 EF Design 依赖图带入 Xml 9.0.0；保留漏洞门禁并钉到已修复补丁。 -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="SemanticVersioning" Version="3.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.1" />
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.15.0" />
    <!-- qian.lifecycle GitOps 执行器验收：真实 K3s 代替 Argo 收敛并提供 K8s API 与服务代理。 -->
    <PackageVersion Include="Testcontainers.K3s" Version="4.15.0" />
    <!-- 契约测试：JSON Schema 2020-12 校验（contracts/v0），ASP.NET Core 内存宿主。 -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.10.2" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
  </ItemGroup>

  <!-- 客户端库：目前只被测试使用；主版本与 Kun 一致，避免 Kun.* 包进来后传递钉版冲突。 -->
  <ItemGroup Label="Clients">
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="StackExchange.Redis" Version="2.13.17" />
  </ItemGroup>

</Project>
