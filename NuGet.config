<?xml version="1.0" encoding="utf-8"?>
<!--
  只用仓库内声明的包源，不受本机全局 NuGet 配置影响，CI 与本地还原结果一致。
  Kun 正式版从 nuget.org 还原，只有需要 Kun 预发布版时才加 GitHub Packages 源。
  Kun.* 显式映射到 nuget.org，ubuntu-latest CI 无需私有源凭据。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Kun.*" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
