<?xml version="1.0" encoding="utf-8"?>
<!--
  只用仓库内声明的包源，不受本机全局 NuGet 配置影响，CI 与本地还原结果一致。
  Kun 的 GitHub Packages 源在首个引用 Kun.* 包的任务里加入，并配 packageSourceMapping。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
